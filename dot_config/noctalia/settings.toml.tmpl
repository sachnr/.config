[bar.default]
position = "bottom"
background_opacity = 0.92
border_width = 0.0
capsule = true
capsule_fill = "surface_container_high"
capsule_opacity = 0.85
capsule_border_width = 0.0
capsule_padding = 8.0
capsule_radius = 9
capsule_thickness = 0.8
start = ["launcher", "workspaces"]
center = ["clock"]
end = [
  "media",
  "tray",
  "ram",
  "network",
  "bluetooth",
  "volume",
  "notifications",
  "control-center",
  "session",
]
font_family = "{{ .font.ui }}"
font_weight = 500
icon_color = "primary"
margin_edge = 0
margin_ends = 0
margin_opposite_edge = 0
radius = 0
radius_top_left = 0
radius_top_right = 0
radius_bottom_left = 0
radius_bottom_right = 0
concave_edge_corners = false
shadow = false
thickness = 40
padding = 16
widget_spacing = 6

[dock]
auto_hide = true
enabled = false
position = "bottom"
reserve_space = false

[location]
auto_locate = true

[plugins]
enabled = ["noctalia/wallhaven"]

[shell]
font_family = "{{ .font.ui }}"
app_icon_color = "primary"
lang = "en"
settings_show_advanced = true

[shell.animation]
speed = 0.6

[shell.panel]
floating_offset = 10
control_center_placement = "floating"
session_placement = "floating"
open_near_click_control_center = true
open_near_click_launcher = false
transparency_mode = "soft"
wallpaper_placement = "floating"

[shell.launcher]
layout = "simple"
search_position = "top"
compact = true
categories = false
show_navigation_labels = false
show_session_button = false
show_settings_button = true
show_app_origin_indicator = false
show_icons = true
colorize_icons = false
app_grid = false
default_view = "recent"
sort_by_usage = true

[theme]
mode = "dark"
source = "wallpaper"
wallpaper_scheme = "m3-content"

[theme.templates]
builtin_ids = [
  "btop",
  "cava",
  "gtk3",
  "gtk4",
  "ghostty",
  "hyprland",
  "kcolorscheme",
  "kitty",
  "qt",
]
community_ids = [
  "codex",
  "opencode",
  "pi-agent",
  "ytm-player",
  "chromium-based",
  "zen-browser",
  "blender",
  "gimp",
  "inkscape",
  "libreoffice",
  "neovim",
  "obsidian",
  "steam",
  "obs",
  "zathura",
  "hyprtoolkit",
  "papirus-icons",
  "bat",
  "fzf",
  "glow",
  "herdr",
  "tmux",
  "yazi",
]

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/wallpapers/"
fill_mode = "center"

[widget.clock]
anchor = true
format = "{:%a, %d %b  ·  %I:%M %p}"

[widget.media]
hide_when_no_media = true
max_length = 180.0
title_scroll = "always"

[widget.network]
show_label = false

[widget.notifications]
hide_when_no_unread = true

[widget.wallhaven]
type = "noctalia/wallhaven:wallhaven"

[widget.workspaces]
font_weight = 600
scale = 1.0

[widget.tray]
type = "tray"
colorize_icons = true
icon_type = "symbolic"

[widget.ram]
capsule = true
type = "sysmon"
stat = "ram_pct"
visualization = "none"
show_value = true

[widget.ram.actions]
left = "exec kitty --title 'Task Manager' -e btop"
